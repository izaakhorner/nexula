# Copy this file to `.env` and fill in the blanks. `.env` is gitignored — NEVER commit real creds.
# You can also skip the file entirely and paste the Creatio creds into the "Credentials" button
# in the dashboard (they live in the server's memory only and clear when you stop it).

# --- Prod Creatio login (required) ---
CREATIO_URL=https://hlpos.creatio.com
CREATIO_USER=
CREATIO_PASS=

# --- Optional: the Case navigation property holding the survey/satisfaction lookup ---
# Stock Creatio Service uses "SatisfactionLevel". Only set this if your instance renamed it.
# CREATIO_SATISFACTION_FIELD=SatisfactionLevel

# --- Optional: expose on your LAN so another device on the same WiFi can open it ---
# Default (unset) = localhost only. Set to 0.0.0.0 to allow other devices on your network.
# HOST=0.0.0.0
